# Copy to ~/.config/dash-channels/channels.env on the host and fill in.
# Keep real values out of git: they are host data.
DASH_CHANNEL_METRO_PORT=
# Address and port the relay listens on (for example the host's tailnet address).
DASH_CHANNEL_RELAY_HOST=
DASH_CHANNEL_RELAY_PORT=
# URL phones use to reach the relay; Metro rewrites bundle URLs to it.
DASH_CHANNEL_PUBLIC_URL=
EXPO_PACKAGER_PROXY_URL=
# Optional: where releases live (default ~/.local/lib/dash/channels/releases).
# DASH_RELEASES_DIR=
# Optional: command run as `<cmd> <tag> <title> <text>` after a nightly with changes or failures.
# DASH_CHANNEL_NOTIFY=
