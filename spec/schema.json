{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/dash/spec/schema.json",
  "title": "Dash feature ledger (spec/features.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baseline", "journeys", "features"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "baseline": {
      "type": "string",
      "description": "Short SHA of the app line the statuses were read from.",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^J-[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 20 }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    },
    "unrequired_surface": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "surface", "note"],
        "properties": {
          "ref": { "$ref": "#/$defs/ref" },
          "surface": { "type": "string", "minLength": 3 },
          "note": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "description": "Repo-relative path, optionally :line (1-based), that exists at the baseline revision.",
      "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_./-]*(:[1-9][0-9]*)?$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "area", "requirement", "owner_quotes", "sources", "surface_refs",
                   "status_from_code", "journey", "priority", "recurring"],
      "properties": {
        "id": { "type": "string", "pattern": "^DF-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 5 },
        "area": {
          "type": "string",
          "enum": ["chat-roster", "chat-window", "composer", "reliability", "performance", "indicators",
                   "generated-ui", "study-mode", "voice", "annotation", "turbo-preview", "process",
                   "orchestra", "approvals", "settings", "pairing", "notifications-share", "navigation",
                   "design-rules", "architecture", "other"]
        },
        "requirement": { "type": "string", "minLength": 20, "description": "Acceptance statement." },
        "owner_quotes": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 3 } },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "surface_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "gap_refs": {
          "type": "array",
          "uniqueItems": true,
          "description": "For missing features: code that shows where the gap is. Never proof of implementation.",
          "items": { "$ref": "#/$defs/ref" }
        },
        "status_from_code": { "type": "string", "enum": ["implemented", "partial", "missing"] },
        "claimed_status": {
          "type": "string",
          "enum": ["implemented", "partial", "missing", "regressed", "unknown"],
          "description": "What agents/reports claimed. Informational; status_from_code wins."
        },
        "journey": { "type": "string", "pattern": "^J-[a-z0-9]+(-[a-z0-9]+)*$" },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "recurring": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}
