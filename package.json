{
  "name": "dash",
  "private": true,
  "scripts": {
    "test": "bash scripts/army.sh",
    "typecheck": "bun app/node_modules/typescript/bin/tsc -p app --noEmit && bun bridge/node_modules/typescript/bin/tsc -p bridge --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "spec": "python3 spec/check.py",
    "spec:status": "python3 scripts/feature_status.py --evidence .acceptance-receipts",
    "spec:handoff": "python3 scripts/preview_handoff.py",
    "spec:law": "python3 -I tests/feature_completion_parity.py && python3 -I tests/feature_completion_mutation.py"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "typescript": "6.0.3"
  }
}
