{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kvnloo/dash/shared/gate.schema.json",
  "title": "Dash upstream gate proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "target",
    "body",
    "evidence",
    "origin"
  ],
  "properties": {
    "kind": {
      "enum": [
        "issue_comment",
        "pr_comment",
        "pr_review_reply",
        "pr_open",
        "pr_ready_for_review",
        "push_branch"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "comment_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "intent": { "enum": ["new_contribution", "existing_review"] },
    "body": {
      "type": "string",
      "maxLength": 60000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url_or_path"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url_or_path": {
            "type": "string"
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "session",
        "created_at"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "dash-owner"
          }
        },
        "session": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}