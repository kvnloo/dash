{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["bun", "react"],
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/*.ts"],
  "exclude": ["node_modules"]
}
