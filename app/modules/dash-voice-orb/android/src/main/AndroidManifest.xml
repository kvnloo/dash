<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for TYPE_APPLICATION_OVERLAY overlay window -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service (already declared in host manifest; safe to redeclare) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: required for microphone-type foreground services -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Partial wake lock to keep service alive while screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- POST_NOTIFICATIONS: show the persistent orb notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="app.dash.orb.VoiceOrbService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
    </application>
</manifest>
